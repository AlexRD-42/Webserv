#!/usr/bin/env bash
set -e
case "$1" in
    game)
        make fast
        exec ./build/webserv assets/configs/game.conf
        ;;
    siege)
        make fast
        exec ./build/webserv assets/configs/siege.conf
        ;;
    valgrind)
        make debug
        exec valgrind ./build/webserv assets/configs/siege.conf
        ;;
	test)
        siege -f assets/configs/siege_urls.txt
		;;
    *)
        echo "Usage: $0 {game|siege|valgrind|test}" >&2
        exit 1
        ;;
esac
